# Copy to .env and fill in what you have. Everything is optional:
# with nothing set, the app runs in offline demo mode with heuristic enrichment.

# demo = replay bundled synthetic news | live = Finnhub + Yahoo Finance RSS + SEC EDGAR
APP_MODE=demo

# LLM: auto picks the first provider that has a key. Options: auto | openai | anthropic | gemini | heuristic
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Live news sources
FINNHUB_API_KEY=
ENABLE_YAHOO_RSS=true
ENABLE_SEC_EDGAR=true
# SEC asks for a descriptive User-Agent with contact details
SEC_USER_AGENT="WatchlistAssistant your.name@example.com"
LOOKBACK_HOURS=24
POLL_INTERVAL_S=300

# Alerting
DEFAULT_WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL
ALERT_MIN_IMPACT=3
MIN_SOURCE_TRUST=0.6
DEDUPE_THRESHOLD=0.45
DEMO_INTERVAL_S=6

# Optional delivery channels for pushed alerts
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
